{
  "name": "locadora-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "preview:frontend": "node scripts/preview-frontend.mjs",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:security": "node scripts/security-check.mjs",
    "check:api": "node scripts/validate-api.mjs",
    "deploy:check": "node scripts/check-deployment.mjs",
    "test:standalone": "node scripts/smoke-standalone.mjs",
    "test:supabase:http": "playwright test --config playwright.supabase.config.ts",
    "test:db": "node scripts/test-database.mjs",
    "test:db:supabase": "supabase test db --local",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --config playwright.records.config.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "pg": "8.23.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
