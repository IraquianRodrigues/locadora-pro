# Copie para .env.local. Não preencha segredos neste arquivo versionado.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=America/Fortaleza
# Preencha as duas variáveis juntas para ativar os clientes Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Servidor apenas. Limitador, arquivos, cotação confiável e consulta/expiração; nunca NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Servidor apenas, aleatório, pelo menos 32 caracteres. Recovery, limites e tokens de consulta.
# Geração local: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Antispam público obrigatório: widget Turnstile com host autorizado e ações quote/reservation.
# Nunca usar chaves de teste em produção. A chave secreta permanece só no servidor.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Worker de contratos/atrasos: segredo aleatório com ao menos 32 caracteres.
# Configurar agendador externo para POST /api/internal/rental-jobs com Authorization: Bearer <segredo>.
RENTAL_JOBS_SECRET=
# Worker de financeiro/manutenção/notificações. POST /api/internal/business-jobs com Bearer.
# Segredo distinto, aleatório, mínimo 32 caracteres; configurar agendador externo.
OPERATIONS_JOBS_SECRET=
# Monitor privado de readiness; diferente dos demais segredos, mínimo 32 caracteres.
READINESS_SECRET=
# Email opcional; sem estes valores a fila não consome tentativas de envio.
# Habilitar rotas EMAIL no painel somente após revisar textos e verificar domínio no Resend.
NOTIFICATION_EMAIL_PROVIDER=
RESEND_API_KEY=
NOTIFICATION_FROM=
